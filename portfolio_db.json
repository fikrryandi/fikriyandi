  "publications": [
    {
      "doi": "",
      "publisher": "Volume 12, Nomor 1, Januari 2028 • SINTA 4",
      "journal": "Jurnal Ilmiah Teknik Industri (INDUSTRIKA)",
      "pdfUrl": "",
      "authors": "Cooming Soon",
      "year": "2026",
      "tags": [
        "Fishbone Diagram",
        "Lean Manufacturing",
        "Preparation Delivery",
        "Scan-Based System",
        "Standard Time",
        "Time Study"
      ],
      "id": "pub-1791007806255",
      "abstract": "Export logistics preparation is often hindered by procedural inefficiencies that risk delaying vessel departures. At PT Velasto Indonesia, a high reliance on manual validation and unstandardized work areas caused significantly prolonged operational times. This study addresses these issues by measuring standard time, identifying wastes, and evaluating the implementation of a scanning (barcode/QR) system. Using Time Study, Lean, and Fishbone Diagram approaches, the initial standard time was recorded at 402.64 minutes per cycle, dominated by waiting, motion, and overprocessing wastes. Improvements were implemented through scan-based validation, pre-Packing rack provision, and inspection document digitization. Consequently, the standard time was significantly reduced to 311.13 minutes, achieving a 22.73% efficiency gain. These findings confirm that combining Lean with simple digital automation effectively eliminates hidden wastes in export logistics.",
      "title": "Analisis Waktu Proses Preparation Delivery ADM Ekspor Melalui Penerapan Sistem By Scan untuk Meminimasi Validasi Manual di PT Velasto Indonesia",
      "link": "https://jurnal.utb.ac.id/index.php/indstrk/index"
    },
    {
      "year": "2027",
      "journal": "Jurnal Ilmiah Teknik Industri (INDUSTRIKA)",
      "abstract": "Employee performance stagnation, which adversely affects productivity, remains a major issue in the manufacturing industry despite increasing investments in technology, indicating that non-technological factors, particularly job satisfaction, have not been optimally managed. This study analyzes the multivariate effects of compensation, work environment, and career development on employee productivity and performance using a CB-SEM approach with data from 400 manufacturing employees in West Java analyzed through AMOS version 24. The results show that compensation (β = 0.322), career development (β = 0.307), and work environment (β = 0.262) have significant positive effects on productivity. Productivity is confirmed as a partial mediator with the strongest influence on employee performance (β = 0.348). The model demonstrates excellent goodness-of-fit (RMSEA = 0.013; CFI = 0.996), emphasizing the importance of fair remuneration strategies, adequate work environments, and clear career development pathways in enhancing productivity and employee performance in the manufacturing industry.",
      "id": "pub-1791007584437",
      "pdfUrl": "",
      "authors": "Cooming Soon",
      "publisher": "Volume 11, Nomor 1, Januari 2027 • SINTA 4",
      "link": "https://jurnal.utb.ac.id/index.php/indstrk/index",
      "tags": [
        "Compensation",
        "employee performance",
        "job satisfaction",
        "productivity",
        "structural equation modeling"
      ],
      "doi": "",
      "title": "Analisis Multivariat Pengaruh Kepuasan Kerja Terhadap Produktivitas Karyawan di Industri Manufaktur Menggunakan Pendekatan CB-SEM"
    }
  ],
